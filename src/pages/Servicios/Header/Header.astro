---
import { Image } from 'astro:assets'

import Badge from '../../../components/Badge/Badge.astro'
import openBoxImage from '../../../assets/images/icons/open-box.svg'
import KeyboardArrowDownIcon from '@mui/icons-material/KeyboardArrowDown'

import './Header.css'
---
<header class="services-header">
    <div class="header-content">
        <Badge className="header-badge" title="Servicios" />
        <h1>Lleva el control de toda tu información con <b>seguridad y eficiencia.</b></h1>
        <a aria-label="Descubre nuestros servicios" href="#diagnostico">
            Descubre nuestros servicios
            <KeyboardArrowDownIcon className="icon" />
        </a>
    </div>
    <Image
        src={openBoxImage}
        class="box-image"
        alt="Caja de archivos con el logo de Data 3000 S.A.S"
        fetchpriority="high"
        loading="eager"
    />
</header>