---
import Badge from '../../../../components/Badge/Badge.astro'
import SupportAgentOutlinedIcon from '@mui/icons-material/SupportAgentOutlined'

import './MoreInfoSection.css'
---

<section class="more-info-section">
    <div class="more-info-header">
        <Badge title="¿Quieres más detalles?" />
        <h2>Descubre cómo podemos ayudarte mejor</h2>
        <p class="more-info-description">Nuestro equipo de expertos está listo para resolver todas tus dudas y proporcionarte una asesoría completamente personalizada según las necesidades específicas de tu archivo.</p>
        <a class="more-info-btn" href="/contactanos">
            <SupportAgentOutlinedIcon className='icon' />
            Recibir asesoría personalizada
        </a>
    </div>
</section>