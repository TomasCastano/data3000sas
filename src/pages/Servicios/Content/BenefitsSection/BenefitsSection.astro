---
import SearchOffIcon from '@mui/icons-material/SearchOff'
import DomainDisabledOutlinedIcon from '@mui/icons-material/DomainDisabledOutlined'
import InventoryOutlinedIcon from '@mui/icons-material/InventoryOutlined'
import EmojiObjectsOutlinedIcon from '@mui/icons-material/EmojiObjectsOutlined'
import LockClockOutlinedIcon from '@mui/icons-material/LockClockOutlined'

import './BenefitsSection.css'

const benefitsData = [
    {
        text: 'Eliminamos el riesgo de documentos extraviados',
        icon: SearchOffIcon
    },
    {
        text: 'Evite ocupar espacios innecesarios en su oficina',
        icon: DomainDisabledOutlinedIcon
    },
    {
        text: 'Recupere el control de su información',
        icon: InventoryOutlinedIcon
    },
    {
        text: 'Soluciones adaptadas a sus necesidades',
        icon: EmojiObjectsOutlinedIcon
    },
    {
        text: 'Mantenga sus archivos protegidos y listos para usar',
        icon: LockClockOutlinedIcon
    }
]
---

<section class="benefits-section">
    <div class="benefits-header">
        <h2>Olvídese del desorden documental</h2>
        <p>Convertimos el caos de archivos en procesos organizados y seguros.</p>
    </div>
    <div class="benefits-list">
        {benefitsData.map((benefit) => (
            <div class="benefit-item">
                <div class="icon-container">
                    <benefit.icon className='icon' />
                </div>
                <p>{benefit.text}</p>
            </div>
        ))}
    </div>
</section>