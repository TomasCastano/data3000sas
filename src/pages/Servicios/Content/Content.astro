---
import diagnostic1Image from '../../../assets/images/diagnostico1.webp'
import diagnostic2Image from '../../../assets/images/diagnostico2.webp'
import diagnostic3Image from '../../../assets/images/diagnostico3.webp'
import organization1Image from '../../../assets/images/organizacion1.webp'
import organization2Image from '../../../assets/images/organizacion2.webp'
import organization3Image from '../../../assets/images/organizacion3.webp'
import digitalizacion1Image from '../../../assets/images/digitalizacion1.webp'
import digitalizacion2Image from '../../../assets/images/digitalizacion2.webp'
import digitalizacion3Image from '../../../assets/images/digitalizacion3.webp'
import almacenamiento1Image from '../../../assets/images/almacenamiento1.webp'
import almacenamiento2Image from '../../../assets/images/almacenamiento2.webp'
import almacenamiento3Image from '../../../assets/images/almacenamiento3.webp'
import almacenamiento4Image from '../../../assets/images/almacenamiento4.webp'

import ServiceCard from '../ServiceCard/ServiceCard.jsx'

import './Content.css'

const servicesData = [
    {
        title: 'Diagnóstico',
        description: 'Realizamos un diagnóstico integral para identificar el estado actual de los documentos, analizar sus contenidos y determinar el volumen total. A partir de esta evaluación, elaboramos un informe claro y detallado con las condiciones encontradas y las acciones necesarias para garantizar la conservación y preservación documental.',
        list: [
        'Evaluación detallada del estado físico y contenido de los documentos',
        'Análisis del volumen total de información',
        'Identificación de riesgos y material deteriorado',
        'Recomendaciones y soluciones a medida',
        'Entrega de informe diagnóstico completo y profesional'
        ],
        images: [diagnostic1Image.src, diagnostic2Image.src, diagnostic3Image.src]
    },
    {
        title: 'Organización',
        description: 'Aplicamos el principio de procedencia para clasificar los documentos y el principio de orden original para su correcta ordenación según la serie documental. Posteriormente, elaboramos un inventario completo en formato FUID. En caso de deterioro, realizamos primeros auxilios y, finalmente, empacamos los archivos de forma segura para garantizar su conservación.',
        list: [
            'Clasificación según el principio de procedencia',
            'Ordenamiento según el principio de orden original',
            'Inventariado completo de documentos en formato FUID',
            'Primeros auxilios a documentos dañados',
            'Empacado eficiente y seguro de documentos'
        ],
        images: [organization1Image.src, organization2Image.src, organization3Image.src]
    },
    {
        title: 'Digitalización',
        description: 'Digitalizamos documentos físicos con escáner de alta calidad, aplicando OCR para facilitar la búsqueda de contenido y archivándolos en formato PDF/A, garantizando su preservación digital a largo plazo. Los archivos se almacenan en repositorios privados y seguros, ya sea en servidores propios o en la nube, optimizando la consulta y gestión de la información.',
        list: [
            'Digitalización en formato PDF/A con preservación a largo plazo',
            'Aplicación de OCR para búsquedas rápidas y precisas',
            'Procesamiento masivo y eficiente de documentos',
            'Compatibilidad con software y herramientas de oficina',
            'Almacenamiento seguro en servidores privados'
        ],
        images: [digitalizacion1Image.src, digitalizacion2Image.src, digitalizacion3Image.src]
    },
    {
        title: 'Almacenamiento',
        description: 'Guardamos la documentación organizada en cajas rotuladas con su respectiva codificación, lo que facilita la ubicación en nuestros almacenes o en repositorios digitales. Con este proceso garantizamos seguridad, orden y disponibilidad inmediata de los archivos cuando se requiera, evitando que su empresa deba destinar costosos espacios de oficina o arrendamientos para mantener archivos desordenados.',
        list: [
            'Entornos seguros físicos y digitales',
            'Ahorro en espacio y costos de arrendamiento',
            'Acceso rápido a la información',
            'Procesos de archivo claros y estandarizados',
            'Cumplimiento de normativas de seguridad archivística'
        ],
        images: [almacenamiento1Image.src, almacenamiento2Image.src, almacenamiento3Image.src, almacenamiento4Image.src]
    }
]
---
<div class="service-content">
    <div class="service-cards-container">
        <ServiceCard client:visible id="diagnostico" service={servicesData[0]} />
        <ServiceCard client:visible id="organizacion" service={servicesData[1]} />
        <ServiceCard client:visible id="digitalizacion" service={servicesData[2]} />
        <ServiceCard client:visible id="almacenamiento" service={servicesData[3]} />
    </div>
</div>