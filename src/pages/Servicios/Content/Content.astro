---
import diagnostic1Image from '../../../assets/images/diagnostico1.webp'
import diagnostic2Image from '../../../assets/images/diagnostico2.webp'
import diagnostic3Image from '../../../assets/images/diagnostico3.webp'
import organization1Image from '../../../assets/images/organizacion1.webp'
import organization2Image from '../../../assets/images/organizacion2.webp'
import organization3Image from '../../../assets/images/organizacion3.webp'
import digitalizacion1Image from '../../../assets/images/digitalizacion1.webp'
import digitalizacion2Image from '../../../assets/images/digitalizacion2.webp'
import digitalizacion3Image from '../../../assets/images/digitalizacion3.webp'
import almacenamiento1Image from '../../../assets/images/almacenamiento1.webp'
import almacenamiento2Image from '../../../assets/images/almacenamiento2.webp'
import almacenamiento3Image from '../../../assets/images/almacenamiento3.webp'
import almacenamiento4Image from '../../../assets/images/almacenamiento4.webp'

import ServiceCard from '../ServiceCard/ServiceCard.jsx'

import './Content.css'

const servicesData = [
    {
        title: 'Diagnóstico',
        description: 'Realizamos un análisis detallado para identificar el estado de sus documentos y conservar la información relevante incluso en materiales deteriorados. Al finalizar, elaboramos un informe que describe las condiciones encontradas y las acciones necesarias para garantizar su preservación.',
        list: [
            'Evaluación completa del estado documental',
            'Detección de riesgos y vulnerabilidades',
            'Análisis de material deteriorado',
            'Propuestas de soluciones personalizadas',
            'Informes detallados de diagnóstico'
        ],
        images: [diagnostic1Image.src, diagnostic2Image.src, diagnostic3Image.src]
    },
    {
        title: 'Organización',
        description: 'Asignamos un orden a la documentación siguiendo la normativa vigente. Cada documento es clasificado, registrado en un inventario y, en caso de deterioro, sometido a un proceso de restauración. Finalmente, se empaca adecuadamente para asegurar su protección.',
        list: [
            'Clasificación según normativa vigente',
            'Inventariado completo de documentos',
            'Restauración de documentos dañados',
            'Sistemas de codificación eficientes',
            'Procesos de archivo optimizados'
        ],
        images: [organization1Image.src, organization2Image.src, organization3Image.src]
    },
    {
        title: 'Digitalización',
        description: 'Transformamos documentos físicos en formato digital para mejorar la productividad en su entorno laboral. Esto facilita la consulta, reduce tiempos de búsqueda, permite compartir la información con mayor facilidad y contribuye a la optimización de recursos.',
        list: [
            'Conversión de alta calidad a formato digital',
            'Optimización para acceso rápido',
            'Procesamiento de documentos en masa',
            'Formatos compatibles con software de oficina',
            'Respaldo seguro en la nube'
        ],
        images: [digitalizacion1Image.src, digitalizacion2Image.src, digitalizacion3Image.src]
    },
    {
        title: 'Almacenamiento',
        description: 'La documentación organizada se guarda en folios o cajas rotuladas que facilitan su ubicación en los almacenes, o en su respectivo repositorio digital. Este proceso asegura protección frente a desastres y brinda tranquilidad al saber que los archivos están seguros y disponibles cuando los necesite.',
        list: [
            'Entornos seguros físicos y digitales',
            'Protección contra desastres naturales',
            'Acceso rápido y excelente disponibilidad',
            'Procesos de archivo optimizados',
            'Cumplimiento de normativas de seguridad'
        ],
        images: [almacenamiento1Image.src, almacenamiento2Image.src, almacenamiento3Image.src, almacenamiento4Image.src]
    }
]
---
<div class="service-content">
    <div class="service-cards-container">
        <ServiceCard client:visible id="diagnostico" service={servicesData[0]}/>
        <ServiceCard client:visible id="organizacion" service={servicesData[1]}/>
        <ServiceCard client:visible id="digitalizacion" service={servicesData[2]}/>
        <ServiceCard client:visible id="almacenamiento" service={servicesData[3]}/>
    </div>
</div>