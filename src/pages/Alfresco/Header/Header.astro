---
import { Image } from 'astro:assets'

import Badge from '../../../components/Badge/Badge.astro'
import openBoxImage from '../../../assets/images/logos/alfresco-logo.svg'

import './Header.css'
---
<header>
    <div class="header-content">
        <Badge className="header-badge" title="Alfresco" />
        <h1>Accede a tus documentos en segundos. Gestión documental con <br><b>Alfresco Community Edition</b></h1>
        <p>Para que tu empresa consulte, organice y gestione documentos digitales al instante. <br>El futuro de tu archivo es digital y es ahora</p>
        <div class="buttons-container">
            <a aria-label="Solicitar demostración de Alfresco" href="#demo" class="cta-button primary">
                <span class="cta-text">Solicitar demo</span>
            </a>
            <a aria-label="Ver planes de Alfresco" href="#planes" class="cta-button secondary">
                <span class="cta-text">Ver planes</span>
            </a>
        </div>
    </div>
    <Image
        src={openBoxImage}
        class="box-image"
        alt="Logo de Alfresco"
        fetchpriority="high"
        loading="eager"
    />
</header>