---
import starImage from '../../../../assets/images/icons/star-sharp.svg'
import starHalfImage from '../../../../assets/images/icons/star-half-sharp.svg'

import './ClientRating.css'
---

<div class="client-rating">
    <div class="rating-stars">
        <img class="star" src={starImage.src} alt="Estrellas de calificación entera" />
        <img class="star" src={starImage.src} alt="Estrellas de calificación entera" />
        <img class="star" src={starImage.src} alt="Estrellas de calificación entera" />
        <img class="star" src={starImage.src} alt="Estrellas de calificación entera" />
        <img class="star" src={starHalfImage.src} alt="Estrella de calificación media" />
        <span>4.6</span>
    </div>
    <span>|</span>
    <p>+500 Clientes satisfechos</p>
</div>