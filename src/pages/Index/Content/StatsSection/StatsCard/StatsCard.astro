---
const { id, title, description } = Astro.props;
const target = Astro.props['data-target'] ?? title;
const prefix = Astro.props['data-prefix'] ?? "";

import "./StatsCard.css";
---

<div class="stat-card">
	<p id={id} class="experience-number" data-target={target} data-prefix={prefix}>{title}</p>
	<p>{description}</p>
</div>