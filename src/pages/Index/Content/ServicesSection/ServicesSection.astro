---
import ServiceCard from './ServiceCard/ServiceCard.astro'
import Badge from '../../../../components/Badge/Badge.astro'

import diagnosticImage from '../../../../assets/images/diagnostico2.webp'
import organizationImage from '../../../../assets/images/organizacion1.webp'
import digitalizationImage from '../../../../assets/images/digitalizacion3.webp'
import storageImage from '../../../../assets/images/almacenamiento4.webp'

import './ServicesSection.css'
---
<section class="services-section">
    <div class="services-container">
        <div class="services-header">
            <Badge className="services-badge" title="Servicios que Brindamos" />
            <h2>Despreocúpate de toda la documentación</h2>
            <div class="services-header-line" />
            <p class="mobile-notice">*Toca las tarjetas para descubrir más</p>
        </div>
        <div class="services-content">
            <ServiceCard
                image={diagnosticImage}
                title="Diagnóstico"
                description="Evaluamos el estado y el volumen de su archivo para diseñar un plan de conservación y gestión documental eficiente."
            />
            <ServiceCard
                image={organizationImage}
                title="Organización"
                description="Aplicamos principios archivísticos para clasificar, ordenar y describir su documentación de manera clara y estructurada."
            />
            <ServiceCard
                image={digitalizationImage}
                title="Digitalización"
                description="Transformamos documentos físicos en archivos digitales seguros y accesibles, optimizando la productividad y consulta."
            />
            <ServiceCard
                image={storageImage}
                title="Almacenamiento"
                description="La documentación ya organizada, es empacada en folios o cajas rotuladas que facilitan su ubicación dentro de los almacenes y registros digitales."
            />
        </div>
    </div>
</section>

<script>
    const isTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0
    const mobileNotice = document.querySelector('.mobile-notice')
    if (isTouch) {
        mobileNotice?.classList.add('active')
    }
</script>