---
import EventRoundedIcon from '@mui/icons-material/EventRounded'
import PermPhoneMsgOutlinedIcon from '@mui/icons-material/PermPhoneMsgOutlined'
import LocationOnOutlinedIcon from '@mui/icons-material/LocationOnOutlined'
import MailOutlineOutlinedIcon from '@mui/icons-material/MailOutlineOutlined'

import { CONTACT } from '../../../../utils/company'

import './ContactInfo.css'
---
<div class="contact-info">
    <div class="cards-container">
        <div class="info-card">
            <div class="card-header">
                <EventRoundedIcon className='icon-bg' />
                <div class="card-icon">
                    <EventRoundedIcon className='icon' />
                </div>
                <h3>Horarios de Atención</h3>
            </div>
            <div class="card-text">
                <p><b>Lunes a Jueves:</b> 7:00 am a 4:30 pm</p>
                <p><b>Viernes:</b> 7:00 am a 4:00 pm</p>
                <p><b>Sábados y Domingos:</b> Cerrado</p>
            </div>
        </div>
        <div class="info-card">
            <div class="card-header">
                <PermPhoneMsgOutlinedIcon className='icon-bg' />
                <div class="card-icon">
                    <PermPhoneMsgOutlinedIcon className='icon' />
                </div>
                <h3>Teléfonos</h3>
            </div>
            <div class="card-text">
                <p><a href={CONTACT.whatsapp1Link} target="_blank" rel="noopener noreferrer">{CONTACT.whatsapp1Display}</a></p>
                <p><a href={CONTACT.whatsapp2Link} target="_blank" rel="noopener noreferrer">{CONTACT.whatsapp2Display}</a></p>
                <p><a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a></p>
            </div>
        </div>
        <div class="info-card">
            <div class="card-header">
                <LocationOnOutlinedIcon className='icon-bg' />
                <div class="card-icon">
                    <LocationOnOutlinedIcon className='icon' />
                </div>
                <h3>Ubicación</h3>
            </div>
            <div class="card-text">
                <p>{CONTACT.addressStreet}</p>
                <p>Barrio La Enea</p>
                <p>{CONTACT.addressLocality}, {CONTACT.addressRegion}, Colombia</p>
            </div>
        </div>
        <div class="info-card">
            <div class="card-header">
                <MailOutlineOutlinedIcon className='icon-bg' />
                <div class="card-icon">
                    <MailOutlineOutlinedIcon className='icon' />
                </div>
                <h3>Correos Electrónicos</h3>
            </div>
            <div class="card-text">
                <p>data3000sa@gmail.com</p>
                <p>data3000sa.thumano@gmail.com</p>
                <p>tecnologia.data3000sa@gmail.com</p>
            </div>
        </div>
    </div>
</div>
