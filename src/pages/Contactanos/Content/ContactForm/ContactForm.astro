---
import VerifiedUserIcon from '@mui/icons-material/VerifiedUser'

import './ContactForm.css'
---
<section class="contact-section">
    <div class="form-header">
        <h2>Queremos escucharte</h2>
        <p>Déjanos tu mensaje y nuestro equipo se pondrá en contacto contigo.</p>
    </div>
    <form class="contact-form" action="">
        <div class="form-row">
            <div class="form-group">
                <label for="name">Nombre <span>*</span></label>
                <input type="text" id="name" name="name" required placeholder="Ingresa tu nombre">
            </div>
            
            <div class="form-group">
                <label for="company">Empresa <span class="optional">(opcional)</span></label>
                <input type="text" id="company" name="company" placeholder="Nombre de tu empresa">
            </div>
        </div>
        
        <div class="form-group">
            <label for="email">Correo Electrónico <span>*</span></label>
            <input type="email" id="email" name="email" required placeholder="tu@email.com">
        </div>
        
        <div class="form-group">
            <label for="phone">Teléfono <span class="optional">(opcional)</span></label>
            <input type="tel" id="phone" name="phone" placeholder="Ej: +57-310-123-4567">
        </div>
        
        <div class="services-section">
            <h3>Servicios de interés <span class="optional">(opcional)</span></h3>
            <div class="checkbox-group">
                <div class="checkbox-item">
                    <input type="checkbox" name="diagnostico" id="diagnostico">
                    <label for="diagnostico">Diagnóstico</label>
                </div>  
                <div class="checkbox-item">
                    <input type="checkbox" name="organizacion" id="organizacion">
                    <label for="organizacion">Organización</label>
                </div>
                <div class="checkbox-item">
                    <input type="checkbox" name="digitalizacion" id="digitalizacion">
                    <label for="digitalizacion">Digitalización</label>
                </div>
                <div class="checkbox-item">
                    <input type="checkbox" name="almacenamiento" id="almacenamiento">
                    <label for="almacenamiento">Almacenamiento</label>
                </div>
            </div>
        </div>
        
        <div class="form-group">
            <label for="message">Mensaje <span>*</span></label>
            <textarea id="message" name="message" required placeholder="Cuéntanos qué necesitas o en qué podemos ayudarte..." rows="5"></textarea>
        </div>

        
        <button type="submit" class="submit-btn" id="submitBtn">Enviar mi consulta</button>
        <p class="privacy-policy">
            Tus datos están seguros con nosotros. Solo los usaremos para responder tu consulta.
            <VerifiedUserIcon className='icon' />
        </p>
    </form>
</section>