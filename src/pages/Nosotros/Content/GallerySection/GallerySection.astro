---
import { Image } from 'astro:assets'

import almacenamiento1 from '../../../../assets/images/almacenamiento1.webp'
import almacenamiento2 from '../../../../assets/images/almacenamiento2.webp'
import almacenamiento3 from '../../../../assets/images/almacenamiento3.webp'
import almacenamiento4 from '../../../../assets/images/almacenamiento4.webp'

import './GallerySection.css'
---
<section class="gallery-section">
    <Image 
        class="gallery-image gallery-image-1" 
        src={almacenamiento1} 
        alt="Imagen de bodega DATA 3000 S.A.S" 
        fetchpriority="auto" 
        loading="lazy" 
    />  
    <Image 
        class="gallery-image gallery-image-3" 
        src={almacenamiento3} 
        alt="Imagen de bodega DATA 3000 S.A.S" 
        fetchpriority="auto" 
        loading="lazy" 
    />
    <Image 
        class="gallery-image gallery-image-4" 
        src={almacenamiento4} 
        alt="Imagen de bodega DATA 3000 S.A.S" 
        fetchpriority="auto" 
        loading="lazy" 
    />
    <Image 
        class="gallery-image gallery-image-2" 
        src={almacenamiento2} 
        alt="Imagen de bodega DATA 3000 S.A.S" 
        fetchpriority="auto" 
        loading="lazy" 
    />
</section>