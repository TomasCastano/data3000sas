---
import OpenInNewRoundedIcon from '@mui/icons-material/OpenInNewRounded'
import DescriptionOutlinedIcon from '@mui/icons-material/DescriptionOutlined'
import SecurityOutlinedIcon from '@mui/icons-material/SecurityOutlined'

import './ResourcesSection.css'
---
<section class="resources-section">
    <header class="resources-header">
        <h2>Mantente Actualizado</h2>
        <p>Accede a nuestro Portafolio de Servicios y a nuestras Políticas de Privacidad y Protección de Datos en un solo clic</p>
    </header>
    <div class="resources-content">
        <div class="resources-card">
            <div class="resources-card-info">
                <div class="icon-container">
                    <DescriptionOutlinedIcon className="icon" />
                </div>
                <h3>Portafolio de Servicios</h3>
                <p>Conoce en detalle todos nuestros servicios y cómo pueden beneficiar a tu empresa.</p>
            </div>
            <a 
                class="file-btn" 
                href="/portafolio_data3000.pdf" 
                target="_blank" 
                rel="noopener noreferrer"
                aria-label="Abrir archivo PDF sobre el portafolio de servicios de DATA 3000 S.A.S"
            >
                <OpenInNewRoundedIcon className="icon" />
            </a>
        </div>
        <div class="resources-card">
            <div class="resources-card-info">
                <div class="icon-container">
                    <SecurityOutlinedIcon className="icon" />
                </div>
                <h3>Políticas de Privacidad</h3>
                <p>Conoce cómo protegemos tu información y garantizamos un manejo responsable de tus datos.</p>
            </div>
            <a 
                class="file-btn" 
                href="/politicas_data3000.pdf" 
                target="_blank" 
                rel="noopener noreferrer"
                aria-label="Abrir archivo PDF sobre las políticas de privacidad y protección de datos de DATA 3000 S.A.S"
            >
                <OpenInNewRoundedIcon className="icon" />
            </a>
        </div>
    </div>
</section>