---
import { CONTACT } from '../../../utils/company'

import './FooterInfo.css'
---

<div class="footer-info-content">
    <div class="footer-content-item">
        <p class="footer-heading">Información</p>
        <ul>
            <li><a href="/">Inicio</a></li>
            <li><a href="/servicios">Servicios</a></li>
            <li><a href="/alfresco">Alfresco</a></li>
            <li><a href="/nosotros">Nosotros</a></li>
            <li><a href="/contactanos">Contáctanos</a></li>
        </ul>
    </div>
    <div class="footer-content-item">
        <p class="footer-heading">Horarios de Atención</p>
        <ul>
            <li><span>Lunes a Jueves</span></li>
            <li>7:00 am a 4:30 pm</li>
            <li><span>Viernes</span></li>
            <li>7:00 am a 4:00 pm</li>
        </ul>
    </div>
    <div class="footer-content-item">
        <p class="footer-heading">Teléfonos</p>
        <ul>
            <li><a href={CONTACT.whatsapp1Link} target="_blank" rel="noopener noreferrer">{CONTACT.whatsapp1Display}</a></li>
            <li><a href={CONTACT.whatsapp2Link} target="_blank" rel="noopener noreferrer">{CONTACT.whatsapp2Display}</a></li>
            <li><a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a></li>
        </ul>
    </div>
    <div class="footer-content-item">
        <p class="footer-heading">Ubicación</p>
        <ul>
            <li>{CONTACT.addressStreet}</li>
            <li>Barrio La Enea</li>
            <li>{CONTACT.addressLocality}, {CONTACT.addressRegion}, Colombia</li>
        </ul>
    </div>
</div>
