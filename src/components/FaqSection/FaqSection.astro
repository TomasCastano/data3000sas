---
import Badge from '../Badge/Badge.astro'
import { FAQS } from '../../utils/company'

import './FaqSection.css'

const { title = "Preguntas frecuentes sobre gestión documental", id = "faq" } = Astro.props
---
<section class="faq-section" id={id} aria-labelledby={`${id}-heading`}>
    <div class="faq-container">
        <div class="faq-header">
            <Badge className="faq-badge" title="Preguntas frecuentes" />
            <h2 id={`${id}-heading`}>{title}</h2>
            <div class="faq-header-line" aria-hidden="true"></div>
            <p class="faq-description">Respuestas directas sobre gestión documental, organización de archivos, digitalización y custodia con Data 3000 S.A.S.</p>
        </div>
        <div class="faq-list">
            {FAQS.map((faq, index) => (
                <details class="faq-item" name="faq-accordion" open={index === 0 ? true : undefined}>
                    <summary class="faq-question">
                        <span class="faq-question-text">{faq.question}</span>
                        <span class="faq-icon" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M8 3.33334V12.6667M3.33333 8H12.6667" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                    </summary>
                    <div class="faq-answer">
                        <p>{faq.answer}</p>
                    </div>
                </details>
            ))}
        </div>
    </div>
</section>

<script>
    // Acordeón exclusivo: solo un <details> abierto a la vez (mejora UX, mantiene semántica nativa)
    const items = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
    items.forEach((item) => {
        item.querySelector('summary')?.addEventListener('click', () => {
            if (item.open) return;
            items.forEach((other) => {
                if (other !== item && other.open) other.open = false;
            });
        });
    });
</script>
