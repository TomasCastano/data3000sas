---
import "../assets/css/reset.css"
const { title, navTheme } = Astro.props

import Navbar from "../sections/Navbar/Navbar.jsx"
import Footer from "../sections/Footer/Footer.astro"
import WhatsAppButton from '../components/WhatsAppButton/WhatsAppButton.astro'

const canonicalUrl = Astro.url.href;
const siteUrl = Astro.site ? Astro.site.href : Astro.url.origin;
const ogImageUrl = new URL("/og-image.webp", siteUrl).href;

const ldJson = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": "Data 3000 S.A.S",
	"url": canonicalUrl,
	"logo": ogImageUrl,
	"image": ogImageUrl,
	"description": "Empresa especializada en gestión documental, digitalización, custodia y organización de archivos empresariales en Manizales y Colombia.",
	"foundingDate": "1998",
	"address": {
		"@type": "PostalAddress",
		"addressLocality": "Manizales",
		"addressRegion": "Caldas",
		"addressCountry": "CO"
	},
	"areaServed": {
		"@type": "Country",
		"name": "Colombia"
	},
	"sameAs": [
		"https://www.instagram.com/data3000sas"
	],
	"knowsAbout": [
		"Gestión Documental",
		"Digitalización de Archivos",
		"Custodia de Documentos",
		"Archivo Empresarial",
		"Organización de Archivos",
		"Data 3000",
		"Data 3000 SAS"
	]
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Básico y Título -->
		<title>{title} | Data 3000 S.A.S</title>
		<meta name="description" content="Data 3000 SAS, expertos en gestión documental. Desde 1998 ofrecemos organización, custodia, digitalización y almacenamiento de archivos con seguridad, eficiencia y más de 26 años de experiencia.">
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalUrl} />
		
		<!-- Open Graph (para redes como Facebook) -->
		<meta property="og:title" content={`${title} | Data 3000 S.A.S`} />
		<meta property="og:description" content="Data 3000 SAS, expertos en gestión documental. Desde 1998 ofrecemos organización, custodia, digitalización y almacenamiento de archivos con seguridad, eficiencia y más de 26 años de experiencia." />
		<meta property="og:image" content={ogImageUrl}>
		<meta property="og:url" content={canonicalUrl}>
		<meta property="og:type" content="website">

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | Data 3000 S.A.S`} />
		<meta name="twitter:description" content="Data 3000 SAS, expertos en gestión documental. Desde 1998 ofrecemos organización, custodia, digitalización y almacenamiento de archivos con seguridad, eficiencia y más de 26 años de experiencia.">
		<meta name="twitter:image" content={ogImageUrl} />

		<!-- Datos Estructurados (JSON-LD) -->
		<script type="application/ld+json" set:html={JSON.stringify(ldJson)} />
	</head>

	<script>
		import Lenis from "lenis"
	
		const lenis = new Lenis({ lerp: 0.1 })
	
		function raf(time: number) {
			lenis.raf(time);
			requestAnimationFrame(raf)
		}
	
		requestAnimationFrame(raf)
	</script>

	<body>
		<Navbar client:only="react" navTheme={navTheme} currentPath={Astro.url.pathname} />
		<slot />
		<Footer />
        <WhatsAppButton />
	</body>
</html>
